rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Cambia este correo por el que usarás como Super Administrador
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "17471333-2@some.cl" || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superuser"
      );
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isSuperAdmin();
    }

    match /system/{document=**} {
      // Cualquiera puede leer (para el visor público)
      allow read: if true;
      
      // Operadores autenticados pueden modificar (avanzar turnos, pausa, audio, etc)
      allow write: if request.auth != null;
    }
  }
}
